/* ─────────────────────────────────────────────────────────────────────────
   Raven TUI Dashboard — Textual CSS
   ───────────────────────────────────────────────────────────────────────── */

/* ── Global ─────────────────────────────────────────────────────────────── */

Screen {
    background: $background;
    color: $foreground;
}

/* ── Layout grid ────────────────────────────────────────────────────────── */

#dashboard {
    layout: grid;
    grid-size: 4 5;
    grid-gutter: 1;
    padding: 0 1;
    height: 1fr;
}

#dashboard.no-containers {
    grid-size: 4 4;
}

/* ── Header bar ─────────────────────────────────────────────────────────── */

#raven-header {
    column-span: 4;
    height: 3;
    background: $surface;
    color: $accent;
    text-align: center;
    padding: 0 2;
    border: solid $panel;
}

/* ── Top row: CPU + Memory ──────────────────────────────────────────────── */

#cpu-panel {
    column-span: 2;
    height: auto;
    min-height: 10;
    background: $surface;
    border: solid $panel;
    padding: 0 1;
}

#memory-panel {
    column-span: 2;
    height: auto;
    min-height: 10;
    background: $surface;
    border: solid $panel;
    padding: 0 1;
}

/* ── Middle row: Processes ──────────────────────────────────────────────── */

#process-panel {
    column-span: 4;
    height: 1fr;
    min-height: 12;
    background: $surface;
    border: solid $panel;
    padding: 0 1;
}

/* ── Bottom row: Disk + Network + Sensors ───────────────────────────────── */

#disk-panel {
    column-span: 2;
    height: auto;
    min-height: 8;
    background: $surface;
    border: solid $panel;
    padding: 0 1;
}

#network-panel {
    column-span: 1;
    height: auto;
    min-height: 8;
    background: $surface;
    border: solid $panel;
    padding: 0 1;
}

#sensor-panel {
    column-span: 1;
    height: auto;
    min-height: 8;
    background: $surface;
    border: solid $panel;
    padding: 0 1;
}

#container-panel {
    column-span: 4;
    height: auto;
    min-height: 6;
    background: $surface;
    border: solid $panel;
    padding: 0 1;
}

/* ── Widget typography ──────────────────────────────────────────────────── */

.panel-title {
    color: $accent;
    text-style: bold;
    padding: 0 0 0 0;
}

.metric-label {
    color: $text-muted;
}

.metric-value {
    color: $text;
    text-style: bold;
}

.metric-good {
    color: $success;
}

.metric-warn {
    color: $warning;
}

.metric-crit {
    color: $error;
}

/* ── Sparkline colours ──────────────────────────────────────────────────── */

Sparkline {
    height: 2;
    margin: 0 0;
}

Sparkline > .sparkline--max-color {
    color: $error;
}

Sparkline > .sparkline--min-color {
    color: $success;
}

/* ── ProgressBar ────────────────────────────────────────────────────────── */

ProgressBar {
    height: 1;
    padding: 0;
}

ProgressBar > .bar--bar {
    color: $accent;
}

ProgressBar > .bar--complete {
    color: $success;
}

/* ── DataTable ──────────────────────────────────────────────────────────── */

DataTable {
    height: 1fr;
    scrollbar-size: 1 1;
}

DataTable > .datatable--header {
    background: $panel;
    color: $accent;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $panel;
    color: $text;
}

/* ── Footer ─────────────────────────────────────────────────────────────── */

Footer {
    background: $surface;
    color: $text-muted;
}

Header {
    background: $background;
    color: $accent;
    dock: top;
    height: 1;
}
