/* ─────────────────────────────────────────────────────────────────────────
   Raven TUI Dashboard — Textual CSS
   ───────────────────────────────────────────────────────────────────────── */

/* ── Global ─────────────────────────────────────────────────────────────── */

Screen {
    background: #0a0e17;
    color: #c8d6e5;
}

/* ── Layout grid ────────────────────────────────────────────────────────── */

#dashboard {
    layout: grid;
    grid-size: 4 5;
    grid-gutter: 1;
    padding: 0 1;
    height: 1fr;
}

/* ── Header bar ─────────────────────────────────────────────────────────── */

#raven-header {
    column-span: 4;
    height: 3;
    background: #141b2d;
    color: #00d2ff;
    text-align: center;
    padding: 0 2;
    border: solid #1e2a45;
}

/* ── Top row: CPU + Memory ──────────────────────────────────────────────── */

#cpu-panel {
    column-span: 2;
    height: auto;
    min-height: 10;
    background: #141b2d;
    border: solid #1e2a45;
    padding: 0 1;
}

#memory-panel {
    column-span: 2;
    height: auto;
    min-height: 10;
    background: #141b2d;
    border: solid #1e2a45;
    padding: 0 1;
}

/* ── Middle row: Processes ──────────────────────────────────────────────── */

#process-panel {
    column-span: 4;
    height: auto;
    min-height: 12;
    max-height: 20;
    background: #141b2d;
    border: solid #1e2a45;
    padding: 0 1;
}

/* ── Bottom row: Disk + Network + Sensors ───────────────────────────────── */

#disk-panel {
    column-span: 2;
    height: auto;
    min-height: 8;
    background: #141b2d;
    border: solid #1e2a45;
    padding: 0 1;
}

#network-panel {
    column-span: 1;
    height: auto;
    min-height: 8;
    background: #141b2d;
    border: solid #1e2a45;
    padding: 0 1;
}

#sensor-panel {
    column-span: 1;
    height: auto;
    min-height: 8;
    background: #141b2d;
    border: solid #1e2a45;
    padding: 0 1;
}

#container-panel {
    column-span: 4;
    height: auto;
    min-height: 6;
    background: #141b2d;
    border: solid #1e2a45;
    padding: 0 1;
}

/* ── Widget typography ──────────────────────────────────────────────────── */

.panel-title {
    color: #00d2ff;
    text-style: bold;
    padding: 0 0 0 0;
}

.metric-label {
    color: #8892b0;
}

.metric-value {
    color: #e6f1ff;
    text-style: bold;
}

.metric-good {
    color: #64ffda;
}

.metric-warn {
    color: #ffd93d;
}

.metric-crit {
    color: #ff6b6b;
}

/* ── Sparkline colours ──────────────────────────────────────────────────── */

Sparkline {
    height: 2;
    margin: 0 0;
}

Sparkline > .sparkline--max-color {
    color: #ff6b6b;
}

Sparkline > .sparkline--min-color {
    color: #64ffda;
}

/* ── ProgressBar ────────────────────────────────────────────────────────── */

ProgressBar {
    height: 1;
    padding: 0;
}

ProgressBar > .bar--bar {
    color: #00d2ff;
}

ProgressBar > .bar--complete {
    color: #64ffda;
}

/* ── DataTable ──────────────────────────────────────────────────────────── */

DataTable {
    height: 1fr;
    scrollbar-size: 1 1;
}

DataTable > .datatable--header {
    background: #1e2a45;
    color: #00d2ff;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1e2a45;
    color: #e6f1ff;
}

/* ── Footer ─────────────────────────────────────────────────────────────── */

Footer {
    background: #141b2d;
    color: #8892b0;
}

Header {
    background: #0a0e17;
    color: #00d2ff;
    dock: top;
    height: 1;
}
